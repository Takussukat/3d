#!/usr/bin/env python3
"""CLI kaggle pour les sessions cloud Claude Code, ou le proxy injecte le jeton Kaggle.

Le jeton est ajoute par le proxy dans l'en-tete Authorization ; la CLI 2.x voudrait d'abord le
verifier en l'envoyant dans le corps d'une requete (IntrospectToken), ce que le proxy ne peut pas
remplir. On saute cette verification et on prend le nom d'utilisateur dans KAGGLE_USERNAME.
Usage : export PATH="$PWD/outils:$PATH" KAGGLE_USERNAME=<utilisateur>
Sur un PC avec un vrai jeton (~/.kaggle/access_token), utiliser la CLI kaggle normale.
"""
import os
import sys

os.environ.setdefault('KAGGLE_API_TOKEN', 'proxy-injected')
from kaggle.api import kaggle_api_extended as api  # noqa: E402

api.KaggleApi._introspect_token = lambda self, token: os.environ['KAGGLE_USERNAME']
sys.argv[0] = 'kaggle'
from kaggle.cli import main  # noqa: E402

sys.exit(main())
